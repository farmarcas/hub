# Modelo das variáveis de produção. No Coolify, preencha no painel (Environment Variables).
# Nunca coloque valores reais aqui nem faça commit de um .env de produção.
POSTGRES_USER=hub
# Gere uma senha forte e única (ex.: openssl rand -base64 32). Não use "app".
POSTGRES_PASSWORD=
POSTGRES_DB=hub

# Identificação simulada ("Entrar como"). Único modo existente hoje.
AUTH_MODE=mock
